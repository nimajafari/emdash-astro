		"posts": [
			{
				"id": "post-migration",
				"slug": "cms-migration-seo-checklist",
				"status": "published",
				"data": {
					"title": "What to Check Before a CMS Migration",
					"excerpt": "A migration keeps its rankings when URLs, signals and templates are mapped before launch, not repaired after it.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=1200&h=800&fit=crop",
							"alt": "Code on a monitor in a dark room",
							"filename": "migration.jpg"
						}
					},
					"content": [
						{
							"_type": "block",
							"_key": "k1",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "k2",
									"text": "Most migration losses are not caused by the new platform. They come from something the old platform did quietly that nobody wrote down."
								}
							]
						},
						{
							"_type": "block",
							"_key": "k3",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"_key": "k4",
									"text": "Crawl the old site first"
								}
							]
						},
						{
							"_type": "block",
							"_key": "k5",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "k6",
									"text": "Take a full crawl before anything changes. Keep the URL list, status codes, titles, canonicals and internal link counts. That file becomes the test you run against the new site."
								}
							]
						},
						{
							"_type": "block",
							"_key": "k7",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"_key": "k8",
									"text": "Map every URL that matters"
								}
							]
						},
						{
							"_type": "block",
							"_key": "k13",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "k10",
									"text": "Every URL with traffic, links or rankings needs a destination. Read our guide to "
								},
								{
									"_type": "span",
									"_key": "k11",
									"text": "redirect mapping",
									"marks": [
										"k9"
									]
								},
								{
									"_type": "span",
									"_key": "k12",
									"text": " before you write the rules."
								}
							],
							"markDefs": [
								{
									"_type": "link",
									"_key": "k9",
									"href": "/posts/redirect-mapping-for-url-changes"
								}
							]
						},
						{
							"_type": "block",
							"_key": "k14",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"_key": "k15",
									"text": "Compare templates, not just pages"
								}
							]
						},
						{
							"_type": "block",
							"_key": "k16",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "k17",
									"text": "Check each template for titles, canonicals, structured data and robots directives. One broken template breaks every page that uses it."
								}
							]
						}
					]
				},
